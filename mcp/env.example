# AIQA API Configuration
# Base URL for the server-aiqa API that this MCP server connects to
AIQA_API_BASE_URL=http://localhost:4318

# MCP Server Configuration
# Port for the MCP HTTP/SSE server (default: 4319)
MCP_PORT=4319

# Public URL Configuration
# The public base URL clients reach this server on. Used in the discovery
# documents the server publishes about itself: the resource_metadata pointer in
# the WWW-Authenticate challenge sent with a 401, and the `resource` field of
# /.well-known/oauth-protected-resource.
# Set this in production. If it is unset, those URLs are derived from the
# incoming request, which behind an HTTPS proxy yields "http://..." - clients
# would be pointed at the wrong scheme. Setting it also makes the discovery
# document cacheable, since the value no longer varies per request.
# MCP_PUBLIC_URL=https://mcp-aiqa.winterwell.com

# Trust X-Forwarded-* headers from a proxy (default: off).
# Off by default because these headers are client-supplied: if they were
# trusted unconditionally, any caller could choose the URLs we advertise.
# Accepts 'true' (trust whatever connects - only safe if nothing but the proxy
# can reach this port) or a comma-separated IP/CIDR allowlist of proxy
# addresses. A bare hop count is NOT supported: Fastify rejects hop-count trust
# as unsafe, so a number here silently trusts nothing. An unparseable value
# fails at startup.
# With the bundled nginx config, which proxies from the same host, use:
# MCP_TRUST_PROXY=127.0.0.1
# This is what makes X-Forwarded-For take effect, so request logs show the real
# client IP rather than the proxy's. It is not needed for correct URLs if
# MCP_PUBLIC_URL is set.

# Logging
LOG_LEVEL=info

# Note: Users provide their API keys when connecting via Cursor/Claude Code
# The MCP server itself doesn't need an API key in its environment

# Optional: For integration tests only
# Integration tests read these from environment variables, not from .env file
# Set them when running tests: export AIQA_API_KEY=your-key && export TEST_ORG_ID=your-org-id
# AIQA_API_KEY=your-api-key-here
# TEST_ORG_ID=your-org-id-here
