
# Note: client environment variables mostly use an AIQA_ prefix to avoid any conflicts.
# These server variables don't, as this is our space and there is no issue with potential conflicts.

ENVIRONMENT=development

PORT=4318

# Postgresql - neon.db
# https://console.neon.tech/app/projects
PGHOST=
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
SPANS_INDEX=aiqa_spans
SPANS_INDEX_ALIAS=aiqa_spans_alias
DATASET_SPANS_INDEX=aiqa_dataset_spans
DATASET_SPANS_INDEX_ALIAS=aiqa_dataset_spans_alias

# Redis (for rate limiting)
REDIS_URL=redis://localhost:6379

# Python report worker (PCA / drift / coverage). On Ubuntu use deploy/aiqa-report-worker.service; default binds 127.0.0.1:8765
REPORT_WORKER_URL=http://127.0.0.1:8765

# Auth0 Configuration
AUTH0_DOMAIN=winterstein.eu.auth0.com
# Accepted JWT audiences, comma-separated. The webapp and OAuth-connected MCP
# clients hold tokens for different Auth0 APIs, and both verify here.
#
# The FIRST audience listed is the admin one by default: it is the audience that
# was in use back when there was only one, i.e. the webapp's. Audiences added
# after it get developer access instead, so an MCP client cannot delete users or
# organisations. Override with AUTH0_ADMIN_AUDIENCES if you need a different
# split. The resolved split is logged at startup.
# The entries after the first are the API MCP clients get tokens for. That is
# the MCP server's own public URL, because it is what its clients send as RFC
# 8707 `resource` and so what Auth0 issues the token for - not this server's
# URL. Both spellings are listed because clients differ on the trailing slash:
# Claude Code sends it, the MCP spec says clients should omit it. Accepting both
# costs nothing; only the one Auth0 has an API for can actually be issued.
# Drop them to refuse OAuth tokens entirely.
AUTH0_AUDIENCE=https://winterstein.eu.auth0.com/api/v2/,https://mcp-aiqa.winterwell.com/,https://mcp-aiqa.winterwell.com
# Optional explicit override of which audiences carry admin (comma-separated).
# AUTH0_ADMIN_AUDIENCES=https://winterstein.eu.auth0.com/api/v2/

AIQA_ADMIN_EMAIL=
